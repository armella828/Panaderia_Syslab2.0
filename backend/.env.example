# ===================================================
# Panaderia_Syslab2.0 - Variables del BACKEND
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ===================================================

# Puerto del servidor Express
PORT=5000

# Entorno de ejecucion
NODE_ENV=development

# Conexion a PostgreSQL local (fuera de Docker)
# Formato: postgresql://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BASE?schema=public
# Si la contrasena contiene caracteres especiales (/, @, :), debes
# codificarlos como porcentaje. Ejemplo: un "/" se escribe %2F
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/panaderia_db?schema=public"

# Origen permitido para CORS (URL del frontend)
FRONTEND_URL=http://localhost:5173

# Clave secreta para firmar tokens JWT (duracion 8 horas)
JWT_SECRET=cambia_esta_clave_en_produccion
JWT_EXPIRES_IN=8h