# ================================================
# SysLab 2.0 - Variables de entorno del BACKEND
# ================================================

# Puerto del servidor Express
PORT=4000

# Entorno de ejecucion
NODE_ENV=development

# Cadena de conexion a PostgreSQL
# IMPORTANTE: dentro de Docker el host es el nombre del servicio: "db"
DATABASE_URL="postgresql://syslab_user:syslab_pass@db:5432/syslab_db?schema=public"

# Si ejecutas el backend fuera de Docker, usa localhost:
# DATABASE_URL="postgresql://syslab_user:syslab_pass@localhost:5432/syslab_db?schema=public"

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Clave secreta para firmar tokens JWT
JWT_SECRET=cambia_esta_clave_por_una_segura
JWT_EXPIRES_IN=1d
