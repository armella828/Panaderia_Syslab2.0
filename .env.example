# ==========================================================
# Panaderia_Syslab2.0 - Variables de entorno de la RAIZ
# Usadas por docker-compose.yml (produccion en Ubuntu/Docker)
# Copia este archivo como .env en la raiz y ajusta los valores.
# ==========================================================

# Credenciales de la base de datos PostgreSQL (contenedor db)
POSTGRES_USER=panaderia_user
POSTGRES_PASSWORD=cambia_esta_contrasena_segura
POSTGRES_DB=panaderia_db
POSTGRES_PORT=5432

# Puerto publico del frontend (http://<servidor>:<FRONTEND_PORT>)
FRONTEND_PORT=5173

# URL del frontend para CORS del backend
FRONTEND_URL=http://localhost:5173

# Clave secreta para firmar tokens JWT (genera una con: openssl rand -base64 48)
JWT_SECRET=cambia_esta_clave_en_produccion
JWT_EXPIRES_IN=8h

# Nombre del proyecto en Docker Compose
COMPOSE_PROJECT_NAME=panaderia